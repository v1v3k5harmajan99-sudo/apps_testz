{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "suite/**/*.ts",
    "flows/**/*.ts",
    "pages/**/*.ts",
    "auth/**/*.ts",
    "fixtures/**/*.ts",
    "playwright.config.ts"
  ]
}
